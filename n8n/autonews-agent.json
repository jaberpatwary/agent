{
  "name": "AutoNews: Agentic news desk",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka"
  },
  "nodes": [
    {
      "id": "c0a1b2c3-0001-4000-8000-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, -100],
      "parameters": { "rule": { "interval": [ { "field": "minutes", "minutesInterval": 15 } ] } }
    },
    {
      "id": "c0a1b2c3-0002-4000-8000-000000000002",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100],
      "parameters": {}
    },
    {
      "id": "c0a1b2c3-0011-4000-8000-000000000011",
      "name": "সম্পাদক এজেন্ট — খবর বাছাই",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "onError": "continueRegularOutput",
      "notes": "নতুন খবরগুলো থেকে কোনটি আগে হবে বাছাই করে",
      "notesInFlow": true,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTONEWS_API_URL }}/api/agent/stage/plan",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "trigger", "value": "n8n" } ] },
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-API-Key", "value": "={{ $env.AUTONEWS_API_KEY }}" } ] },
        "options": { "timeout": 870000, "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "c0a1b2c3-0012-4000-8000-000000000012",
      "name": "খবর আছে?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [500, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [ { "id": "c0a1b2c3-0c12-4000-8000-000000000012", "leftValue": "={{ $json.next }}", "rightValue": "verify", "operator": { "type": "string", "operation": "equals" } } ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c0a1b2c3-0013-4000-8000-000000000013",
      "name": "প্রতিবেদক এজেন্ট — যাচাই",
