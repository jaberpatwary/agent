      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTONEWS_API_URL }}/api/agent/stage/verify",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "run_id", "value": "={{ $json.run_id }}" } ] },
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-API-Key", "value": "={{ $env.AUTONEWS_API_KEY }}" } ] },
