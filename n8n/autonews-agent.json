{
  "name": "AutoNews: Agentic news desk",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka"
  },
  "nodes": [
    {
      "id": "c0a1b2c3-0001-4000-8000-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "c0a1b2c3-0002-4000-8000-000000000002",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "parameters": {}
    },
    {
      "id": "c0a1b2c3-0003-4000-8000-000000000003",
      "name": "Start agent desk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTONEWS_API_URL }}/api/agent/run",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "trigger",
              "value": "n8n"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTONEWS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "c0a1b2c3-0004-4000-8000-000000000004",
      "name": "Let the agent work (5 min)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ],
      "webhookId": "c0a1b2c3-0000-4000-8000-00000000b001",
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "minutes"
      }
    },
    {
      "id": "c0a1b2c3-0005-4000-8000-000000000005",
      "name": "Check desk status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AUTONEWS_API_URL }}/api/agent/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTONEWS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "c0a1b2c3-0006-4000-8000-000000000006",
      "name": "Summarise run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "jsCode": "// One line per recent run so the n8n execution log shows what the agent did.\nconst s = $input.first().json;\nconst last = (s.recent || [])[0] || {};\nreturn [{ json: {\n  running: s.running, current: s.current || \"\",\n  last_status: last.status, processed: last.processed, candidates: last.candidates,\n  tokens: last.tokens, editor_agent_note: last.plan_note, error: last.error || \"\",\n} }];"
      }
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Start agent desk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run manually": {
      "main": [
        [
          {
            "node": "Start agent desk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start agent desk": {
      "main": [
        [
          {
            "node": "Let the agent work (5 min)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Let the agent work (5 min)": {
      "main": [
        [
          {
            "node": "Check desk status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check desk status": {
      "main": [
        [
          {
            "node": "Summarise run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
