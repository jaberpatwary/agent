# Copy this file to .env and fill in real values for local development.
# On Render.com, set these as Environment Variables in the dashboard instead.

PORT=8080

# Postgres connection string (Neon, Supabase, or local docker-compose db).
# Example (Neon):     postgres://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
# Example (Supabase):  postgres://postgres:pass@db.xxxx.supabase.co:5432/postgres
# Example (local):     postgres://postgres:postgres@localhost:5432/bangla_news?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bangla_news?sslmode=disable

# JWT signing secret for admin sessions — use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=24h

# Groq (primary AI summarizer) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (fallback AI summarizer) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Additional AI fallback providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Cron worker settings
CRON_INTERVAL=10m
FEED_WORKER_COUNT=5
DISABLE_BACKGROUND_WORKER=false

APP_ENV=development

# Public URL of the live site (no trailing slash). Used to build sitemap.xml,
# canonical links, and absolute OpenGraph/JSON-LD URLs for SEO and social
# sharing previews. Leave blank in local dev; set it on Render to your real
# domain, e.g. https://news.example.com
PUBLIC_BASE_URL=

# Local directory to cache downloaded hero images in, served back at /img/...
# so the site never breaks when a source blocks hotlinking or removes an
# image. Set to empty to disable (articles then hotlink the source directly,
# the old behavior). NOTE: on hosts with ephemeral disk (e.g. Render's free
# web service tier), this cache is lost on redeploy/restart — mount a
# persistent disk at this path, or point it at a synced volume, if that
# matters for you.
IMAGE_STORAGE_DIR=./data/images

# Optional daily cap on AI tokens (across all providers combined, UTC day).
# Once today's usage reaches this, the cron worker stops making new AI calls
# until the next day and falls back to publishing original/unrewritten text
# (held for review) instead. 0 = unlimited.
AI_DAILY_TOKEN_BUDGET=0

# Default admin account created on first run if admin_users table is empty.
# CHANGE THE PASSWORD immediately after first login.
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123

# n8n integration. When set, enables GET /api/n8n/pending and
# POST /api/n8n/articles (header X-API-Key) so an n8n workflow can do the AI
# rewrite instead of the built-in worker. Min 24 chars; empty disables it.
# Generate one with: openssl rand -hex 32
N8N_API_KEY=
# Groq model the bundled n8n workflow (n8n/autonews-rewrite.json) uses.
N8N_GROQ_MODEL=openai/gpt-oss-120b
# Cheaper Groq model the workflow uses for the fake check and web-search source check.
N8N_CHECK_MODEL=openai/gpt-oss-20b

# AI gateway (POST /api/n8n/ai) provider order — see internal/ai/gateway.go:
#   web-search steps: Groq (N8N_GROQ_MODEL / N8N_CHECK_MODEL) -> Gemini with Google Search
#   writing steps:    GEMINI_MODEL -> GEMINI_FALLBACK_MODEL -> Groq -> Cohere -> Cloudflare
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Cloudflare Workers AI: needs an API token with "Workers AI" permission AND the account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# Used by `make stop` / `make host-start` to suspend or resume the hosted Render service.
# Put the real key in .env only; never commit it.
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-dbjp6m6tlv9c73dt868g
